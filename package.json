{
  "name": "nyrima",
  "private": true,
  "version": "0.1.0",
  "description": "A personal video cinema that lives on Google Drive. Built as a Chrome Extension.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/itim": "^5.2.7",
    "@fontsource/klee-one": "^5.2.8",
    "@fontsource/m-plus-rounded-1c": "^5.2.10",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@once-ui-system/core": "1.6.4",
    "classnames": "^2.5.1",
    "jassub": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "sharp": "^0.34.5",
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    },
    "vite": {
      "rollup": "^4.60.3"
    },
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.79.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.6"
  }
