# Nyrima web app — environment template. Copy to `.env.local` (gitignored).
#
# Only variables the app code actually reads are listed here. All are VITE_*
# (compiled into the browser bundle) and are PUBLIC — only publishable/anon
# values belong here, gated by Supabase Row Level Security.
#
# There is no server component in this project yet (no Redis, no Edge
# Functions, no second/server-side Google OAuth client), so there is nothing
# server-only to configure. See docs/supabase-and-cache-architecture.md if
# that ever changes — server-only variables must never be prefixed VITE_ or
# imported into frontend code.

# Supabase project. When both are set, the app uses Supabase Auth + Postgres;
# when unset, it falls back to the local mock auth + local repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin of the deployed site, used to build OAuth redirect URLs
# (e.g. https://nyrima.app → redirect https://nyrima.app/auth/callback).
# Falls back to window.location.origin when unset.
VITE_PUBLIC_SITE_URL=

# Google Drive OAuth (frontend-only token flow — NO client secret here).
# Create a Google Cloud OAuth client of type "Web application" and paste its
# client id below. See docs/oauth-setup.md.
VITE_GOOGLE_CLIENT_ID=

# The web redirect URI. Must EXACTLY match an Authorized redirect URI on the
# Google OAuth client. Local dev:
VITE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Production (set in the deploy env, not committed):
#   VITE_GOOGLE_OAUTH_REDIRECT_URI=https://<production-domain>/auth/google/callback

# Developer and Project Info
VITE_DEVELOPER_NAME="Dang Khoa"
VITE_DEVELOPER_EMAIL="pldkhoa.work@gmail.com"
VITE_NYRIMA_REPO_URL="https://github.com/EndlessMelody/Nyrima"
