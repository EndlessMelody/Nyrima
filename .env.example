# Nyrima web app — environment template. Copy to `.env.local` (gitignored).
#
# ───────────────────────────────────────────────────────────────────────────
# TWO TIERS OF SECRETS — DO NOT MIX THEM
#
#  • VITE_* variables are compiled into the browser bundle and are PUBLIC.
#    Only put publishable/anon values here. Never a service-role key, client
#    secret, or Redis token.
#  • Everything in the "SERVER-ONLY" block below must live ONLY in a trusted
#    server runtime (Supabase Edge Functions / a backend API). It must NEVER be
#    prefixed VITE_ and never imported into frontend code.
# ───────────────────────────────────────────────────────────────────────────


# ===========================================================================
# FRONTEND-SAFE (VITE_*) — shipped to the browser, gated by RLS
# ===========================================================================

# Supabase project. When both are set, the app uses Supabase Auth + Postgres;
# when unset, it falls back to the local mock auth + local repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin of the deployed site, used to build OAuth redirect URLs
# (e.g. https://nyrima.app → redirect https://nyrima.app/auth/callback).
# Falls back to window.location.origin when unset.
VITE_PUBLIC_SITE_URL=

# Google Drive OAuth (frontend-only token flow — NO client secret here).
# Create a Google Cloud OAuth client of type "Web application" and paste its
# client id below. This is PUBLIC; the secret stays server-side (and is unused
# while the app runs frontend-only via the implicit token flow).
VITE_GOOGLE_CLIENT_ID=

# The web redirect URI. Must EXACTLY match an Authorized redirect URI on the
# Google OAuth client. Local dev:
VITE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Production (set in the deploy env, not committed):
#   VITE_GOOGLE_OAUTH_REDIRECT_URI=https://<production-domain>/auth/google/callback
# If unset, the app falls back to `${window.location.origin}/auth/google/callback`.

# Deprecated alias for VITE_GOOGLE_CLIENT_ID (still read as a fallback).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional Drive scope override (defaults live in src/config/googleOAuth.ts).
VITE_GOOGLE_DRIVE_SCOPE=

# Optional future REST API base. Unset = local/Supabase repository boundary.
VITE_API_BASE_URL=

# Developer and Project Info
VITE_DEVELOPER_NAME="Dang Khoa"
VITE_DEVELOPER_EMAIL="pldkhoa.work@gmail.com"
VITE_NYRIMA_REPO_URL="https://github.com/EndlessMelody/Nyrima"


# ===========================================================================
# SERVER-ONLY — NEVER prefix with VITE_, NEVER import in frontend code.
# Use only inside Supabase Edge Functions or a trusted backend. These are
# documented here for deployment; they are not read by the Vite app.
# ===========================================================================

# Supabase service-role key — bypasses RLS. Server use only.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (volatile cache / locks / rate-limit). Server use only.
# Redis is a cache layer, never the source of truth, and is reachable ONLY
# through a trusted server (Edge Function / backend) — never the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Drive OAuth — token exchange/refresh happens server-side.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
